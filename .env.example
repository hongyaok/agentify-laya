PORT=3777
HOST=127.0.0.1
# Where the 1.7GB ONNX bundle is cached. Defaults to ~/.cache/receptron-laya
#LAYA_CACHE=
# Point at a local bundle dir to skip downloads (must hold laya.onnx, laya.onnx.data, laya_config.json, tokenizer/)
#LAYA_MODEL_DIR=
# Pin HF bundle revision for reproducible weights
#LAYA_REVISION=main
# Token for private HF repos
#HF_TOKEN=
# Set to 1 to run without the model (deterministic stub answers, for CI and smoke tests)
#MOCK_LAYA=
# Set to 1 to skip eager model load on boot (lazy-load on first request)
#SKIP_WARMUP=
# Directory for usage store (events.jsonl + api-key.txt). Defaults to ./data. Gitignored.
#DATA_DIR=data
# Override the generated cosmetic API key shown in the dashboard (server accepts any Bearer header)
#LAYA_API_KEY=
# Set to 1 to stop npm start from auto-opening the dashboard in your browser
#NO_BROWSER=
